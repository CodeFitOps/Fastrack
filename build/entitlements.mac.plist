<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron necesita ambas para arrancar con hardened runtime activado. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Sin acceso a red, cámara, micrófono ni ubicación: la app funciona
       entera sin conexión y pedirlos sólo daría avisos que asustan. -->
</dict>
</plist>
